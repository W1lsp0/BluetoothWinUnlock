<Window x:Class="BluetoothUnlock.ConfigUi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BluetoothWinUnlock"
        Width="1080"
        Height="760"
        MinWidth="920"
        MinHeight="660"
        Background="{StaticResource PageBackground}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111827">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,18">
                    <TextBlock Text="Bluetooth"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="WinUnlock"
                               Foreground="#93C5FD"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="蓝牙触发的 Windows 解锁"
                               Foreground="#94A3B8"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ListBox x:Name="NavigationList"
                         SelectionChanged="NavigationList_SelectionChanged"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         Margin="12,8,12,20">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Height" Value="42" />
                            <Setter Property="Margin" Value="0,3" />
                            <Setter Property="Foreground" Value="#CBD5E1" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#2563EB" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Content="状态" />
                    <ListBoxItem Content="凭据" />
                    <ListBoxItem Content="蓝牙设备" />
                    <ListBoxItem Content="安装维护" />
                    <ListBoxItem Content="日志诊断" />
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,22" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="PageTitleText"
                               Text="状态"
                               FontSize="28"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="PageSubtitleText"
                               Text="查看服务、凭据、蓝牙和授权窗口状态。"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,6,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Right"
                        Style="{StaticResource Card}"
                        Padding="14,10"
                        Width="240">
                    <TextBlock x:Name="AdminText"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold" />
                </Border>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid x:Name="StatusPage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,0,18">
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="服务" Style="{StaticResource SmallCaption}" />
                                <TextBlock x:Name="ServiceStatusText" Text="--" FontSize="22" FontWeight="SemiBold" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="凭据" Style="{StaticResource SmallCaption}" />
                                <TextBlock x:Name="CredentialStatusText" Text="--" FontSize="22" FontWeight="SemiBold" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="自动提交" Style="{StaticResource SmallCaption}" />
                                <TextBlock x:Name="AutoSubmitStatusText" Text="--" FontSize="22" FontWeight="SemiBold" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="蓝牙" Style="{StaticResource SmallCaption}" />
                                <TextBlock x:Name="BluetoothStatusText" Text="--" FontSize="22" FontWeight="SemiBold" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="授权窗口" Style="{StaticResource SmallCaption}" />
                                <TextBlock x:Name="VerifiedStatusText" Text="--" FontSize="22" FontWeight="SemiBold" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="当前摘要" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                <Button Content="刷新状态"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="RefreshStatus_Click" />
                            </DockPanel>
                            <TextBlock x:Name="SummaryText"
                                       Margin="0,20,0,0"
                                       FontSize="15"
                                       LineHeight="26"
                                       Foreground="{StaticResource TextSecondary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="CredentialPage" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" MaxWidth="640" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Windows 凭据" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="请填写 Windows 登录密码，不是 Windows Hello PIN。"
                                       Style="{StaticResource SmallCaption}"
                                       Margin="0,6,0,20" />

                            <TextBlock Text="域" Style="{StaticResource SmallCaption}" />
                            <TextBox x:Name="DomainTextBox" Style="{StaticResource FieldBox}" Margin="0,6,0,14" />

                            <TextBlock Text="用户名" Style="{StaticResource SmallCaption}" />
                            <TextBox x:Name="UsernameTextBox" Style="{StaticResource FieldBox}" Margin="0,6,0,14" />

                            <TextBlock Text="密码" Style="{StaticResource SmallCaption}" />
                            <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordFieldBox}" Margin="0,6,0,14" />

                            <CheckBox x:Name="AutoSubmitCheckBox"
                                      Content="上划进入登录界面后自动提交 Bluetooth Unlock"
                                      Margin="0,6,0,20" />

                            <Button Content="保存凭据"
                                    Width="150"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="SaveCredential_Click" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="BluetoothPage" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="扫描结果" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="先在 Windows 设置中完成蓝牙配对，再扫描。"
                                           Style="{StaticResource SmallCaption}"
                                           Margin="0,6,0,14" />
                                <Button Content="扫描蓝牙设备"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="ScanBluetooth_Click" />
                            </StackPanel>
                            <Button DockPanel.Dock="Bottom"
                                    Content="添加到可信列表"
                                    Margin="0,12,0,0"
                                    Style="{StaticResource SuccessButton}"
                                    Click="AddTrustedDevice_Click" />
                            <ListBox x:Name="ScannedDevicesListBox"
                                     Margin="0,16,0,0"
                                     DisplayMemberPath="DisplayText" />
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="可信设备" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="任意一个可信设备靠近时都会自动授权。"
                                           Style="{StaticResource SmallCaption}"
                                           Margin="0,6,0,14" />
                                <CheckBox x:Name="BluetoothEnabledCheckBox"
                                          Content="设备靠近时自动授权"
                                          Margin="0,0,0,14" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="扫描间隔（秒）" Style="{StaticResource SmallCaption}" />
                                        <TextBox x:Name="ProbeIntervalTextBox" Style="{StaticResource FieldBox}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="授权秒数" Style="{StaticResource SmallCaption}" />
                                        <TextBox x:Name="BluetoothGrantTextBox" Style="{StaticResource FieldBox}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="移除"
                                        Style="{StaticResource DangerButton}"
                                        Margin="0,0,10,0"
                                        Click="RemoveTrustedDevice_Click" />
                                <Button Content="保存蓝牙设置"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="SaveBluetooth_Click" />
                            </StackPanel>
                            <ListBox x:Name="TrustedDevicesListBox" Margin="0,0,0,12" />
                        </DockPanel>
                    </Border>
                </Grid>

                <Grid x:Name="MaintenancePage" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" MaxWidth="720" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="安装维护" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="需要管理员权限。Provider 更新后建议重启 Windows。"
                                       Style="{StaticResource SmallCaption}"
                                       Margin="0,6,0,20" />
                            <UniformGrid Columns="2">
                                <Button Content="安装服务" Style="{StaticResource PrimaryButton}" Margin="0,0,10,10" Click="InstallService_Click" />
                                <Button Content="安装 Provider" Style="{StaticResource PrimaryButton}" Margin="0,0,0,10" Click="InstallProvider_Click" />
                                <Button Content="刷新状态" Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" Click="RefreshStatus_Click" />
                                <Button Content="测试授权" Style="{StaticResource SuccessButton}" Margin="0,0,0,10" Click="Grant_Click" />
                                <Button Content="卸载" Style="{StaticResource DangerButton}" Margin="0,0,10,10" Click="Uninstall_Click" />
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="测试授权秒数" VerticalAlignment="Center" Style="{StaticResource SmallCaption}" />
                                <TextBox x:Name="GrantSecondsTextBox" Width="90" Style="{StaticResource FieldBox}" Margin="12,0,0,0" Text="60" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="LogsPage" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,14">
                                <Button Content="刷新状态" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="RefreshStatus_Click" />
                                <Button Content="复制诊断信息" Style="{StaticResource PrimaryButton}" Click="CopyDiagnostics_Click" />
                            </StackPanel>
                            <TextBox x:Name="OutputTextBox"
                                     Background="{StaticResource ConsoleBackground}"
                                     Foreground="#DDE7F5"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     Padding="14"
                                     IsReadOnly="True"
                                     TextWrapping="NoWrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
